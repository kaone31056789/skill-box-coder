# ---------- LLM (OpenRouter) ----------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free
# auto = template for built-in designs, LLM for self-contained.
# llm = always generate with the model (much slower).
ENGINEER_MODE=auto
LLM_MAX_TOKENS=32768
LLM_TEMPERATURE=0.7

# Optional: use Anthropic directly instead of OpenRouter
ANTHROPIC_API_KEY=

# auto | openrouter | anthropic | offline
# "auto" picks openrouter -> anthropic -> offline based on which keys exist.
LLM_PROVIDER=auto

# ---------- Per-agent model routes ----------
# Each is a comma-separated chain tried left to right. Empty falls through to
# LLM_MODEL + LLM_FALLBACK_MODELS. Defaults are measured -- see docs/MODELS.md.
LLM_ROUTE_SCOUT=
LLM_ROUTE_SCIENTIST=
LLM_ROUTE_EXPERIMENTALIST=
LLM_ROUTE_ENGINEER=
LLM_ROUTE_ANALYST=
LLM_ROUTE_PI=

# Reasoning budget: low | medium | high | none.
# Uncapped reasoning cost 359s on a single code-generation call.
LLM_REASONING_EFFORT=low

# ---------- Database ----------
# Local dev default is SQLite. Railway injects a postgresql:// URL automatically.
DATABASE_URL=sqlite:///./genesis.db

# ---------- Sandbox ----------
# auto | docker | subprocess
SANDBOX_BACKEND=auto
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2.0
SANDBOX_IMAGE=genesis-sandbox:latest

# ---------- Literature ----------
ENABLE_ARXIV=true
ARXIV_TIMEOUT_SECONDS=12
MAX_PAPERS=12

# ---------- API ----------
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
